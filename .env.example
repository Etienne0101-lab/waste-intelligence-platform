# Environment configuration template for waste-intelligence platform
# Copy to .env and fill in actual values

# Database
POSTGRES_PASSWORD=changeme
POSTGRES_USER=postgres
POSTGRES_DB=waste

# MQTT
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_ENABLED=false

# Hub API
HUB_HOST=0.0.0.0
HUB_PORT=5000
HUB_LOG_LEVEL=INFO

# Cloud services
CLOUD_REGION=us-east-1
CLOUD_STORAGE_BUCKET=waste-intelligence-data

# Grafana
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_ADMIN_USER=admin

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
